# Terraform working directory
.terraform/
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform transient lock files
.terraform.tfstate.lock.info

# Terraform CLI configuration
.terraformrc
terraform.rc

# Environment files
.env
.env.*

# Private keys
*.pem
*.key